<Window x:Class="ProductShop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProductShop"
        mc:Ignorable="d"
        Title="Управление продуктами" Height="650" Width="850"
        FontFamily="Arial Black" FontSize="20"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель с кнопками -->
        <StackPanel Grid.Column="0" Background="#B0B0B0">
            <Button x:Name="ViewButton" Content="Просмотр" Height="40" Margin="5"
                    Click="ViewButton_Click"/>
            <Button x:Name="AddButton" Content="Добавить" Height="40" Margin="5"
                    Click="AddButton_Click"/>
            <Button x:Name="DeleteButton" Content="Удалить" Height="40" Margin="5"
                    IsEnabled="False" Click="DeleteButton_Click"/>
            <Button x:Name="EditButton" Content="Изменить" Height="40" Margin="5"
                    IsEnabled="False" Click="EditButton_Click"/>
        </StackPanel>

        <!-- Правая часть -->
        <Grid Grid.Column="1" Margin="10">
            <ListBox x:Name="ProductsListBox"
                     BorderThickness="1" BorderBrush="Black"
                     SelectionChanged="ProductsListBox_SelectionChanged"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Black" BorderThickness="1" Margin="5" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Image Grid.Column="0" Grid.Row="0"
                                       Source="{Binding Image}"
                                       Width="180" Height="180"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       ImageFailed="Image_ImageFailed"/>

                                <TextBlock Grid.Column="1" Grid.Row="0"
                                           Text="{Binding Name}"
                                           FontSize="25" FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           Margin="10,0,0,0"/>

                                <Viewbox Grid.Column="1" Grid.Row="0"
                                         Stretch="Uniform" StretchDirection="Both"
                                         MaxHeight="150" Margin="10,40,0,0"
                                         HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Description}"
                                               TextWrapping="Wrap"
                                               Width="400" FontSize="16"/>
                                </Viewbox>

                                <TextBlock Grid.Column="0" Grid.Row="1"
                                           HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="18">
                                    <Run Text="Цена: "/>
                                    <Run Text="{Binding Price, StringFormat='{}{0} ₽'}"/>
                                </TextBlock>

                                <TextBlock Grid.Column="1" Grid.Row="1"
                                           Margin="10,10,0,0" FontSize="18">
                                    <Run Text="Количество: "/>
                                    <Run Text="{Binding Count}"/>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <local:ProductWindow x:Name="ProductFormControl" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>